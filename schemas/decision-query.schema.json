{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalrank.ai/schemas/decision-query.schema.json",
  "title": "EvalRank Decision Query V2",
  "description": "Three required fields. Optional fields narrow the candidates; defaults: via from provider_ids (openai when provider_ids is [\"openai\"], else openrouter), api chat_completions, reasoning_effort medium, usage_profile the default agent task mix (8,000 cached + 1,000 fresh input + 500 output tokens).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cell_id",
    "objective"
  ],
  "properties": {
    "object": {
      "const": "decision_query"
    },
    "schema_version": {
      "const": "2"
    },
    "cell_id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "objective": {
      "enum": [
        "lowest_cost_within_top_set",
        "capability_top_set"
      ]
    },
    "via": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Call surface: openrouter or openai. Any other host answers 422 via_not_supported until its efforts are probed."
    },
    "provider_ids": {
      "$ref": "#/$defs/NonEmptyStringSet"
    },
    "api": {
      "enum": [
        "chat_completions",
        "responses"
      ]
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "Comparison level; capability_top_set ignores it unless pinned."
    },
    "regions": {
      "$ref": "#/$defs/NonEmptyStringSet"
    },
    "minimum_context_tokens": {
      "$ref": "#/$defs/PositiveSafeInteger"
    },
    "usage_profile": {
      "$ref": "#/$defs/UsageProfile"
    }
  },
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "NonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "NonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "UsageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "uncached_input_tokens",
        "cached_read_tokens",
        "output_tokens",
        "cache_writes",
        "cache_storage_token_seconds"
      ],
      "properties": {
        "basis": {
          "enum": [
            "measured",
            "estimated"
          ]
        },
        "uncached_input_tokens": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        },
        "cached_read_tokens": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        },
        "output_tokens": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        },
        "cache_writes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CacheWriteUsage"
          }
        },
        "cache_storage_token_seconds": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        }
      },
      "anyOf": [
        {
          "properties": {
            "uncached_input_tokens": {
              "minimum": 1
            }
          },
          "required": [
            "uncached_input_tokens"
          ]
        },
        {
          "properties": {
            "cached_read_tokens": {
              "minimum": 1
            }
          },
          "required": [
            "cached_read_tokens"
          ]
        },
        {
          "properties": {
            "output_tokens": {
              "minimum": 1
            }
          },
          "required": [
            "output_tokens"
          ]
        },
        {
          "properties": {
            "cache_writes": {
              "minItems": 1
            }
          },
          "required": [
            "cache_writes"
          ]
        }
      ]
    },
    "CacheWriteUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttl_seconds",
        "tokens"
      ],
      "properties": {
        "ttl_seconds": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "tokens": {
          "$ref": "#/$defs/PositiveSafeInteger"
        }
      }
    }
  }
}
